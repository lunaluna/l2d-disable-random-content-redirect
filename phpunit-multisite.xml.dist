<?xml version="1.0"?>
<!--
	マルチサイトでの PHPUnit の設定.
	WP_TESTS_MULTISITE を 1 にすると, コアのテスト用ライブラリがサブディレクトリ型のマルチサイトを作る
	(includes/bootstrap.php と includes/install.php).
-->
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
	bootstrap="tests/phpunit/bootstrap.php"
	backupGlobals="false"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	convertErrorsToExceptions="true"
	convertWarningsToExceptions="true"
	convertNoticesToExceptions="true"
	convertDeprecationsToExceptions="true"
	>
	<php>
		<const name="WP_TESTS_MULTISITE" value="1" />
	</php>
	<testsuites>
		<testsuite name="l2ddrcr">
			<directory prefix="class-l2ddrcr-test-" suffix=".php">tests/phpunit/tests</directory>
		</testsuite>
	</testsuites>
</phpunit>
